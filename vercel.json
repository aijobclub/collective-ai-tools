{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render-public.mjs": {
      "includeFiles": "{dist/app-shell.html,ssr-build/**/*.js}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/render-public?pagePath=/" },
    { "source": "/tools", "destination": "/api/render-public?pagePath=/tools" },
    {
      "source": "/tools/:id",
      "destination": "/api/render-public?pagePath=/tools/:id"
    },
    {
      "source": "/mcp-catalog",
      "destination": "/api/render-public?pagePath=/mcp-catalog"
    },
    {
      "source": "/mcp-catalog/:id",
      "destination": "/api/render-public?pagePath=/mcp-catalog/:id"
    },
    {
      "source": "/prompts",
      "destination": "/api/render-public?pagePath=/prompts"
    },
    {
      "source": "/skills",
      "destination": "/api/render-public?pagePath=/skills"
    },
    {
      "source": "/trending",
      "destination": "/api/render-public?pagePath=/trending"
    },
    {
      "source": "/leaderboard",
      "destination": "/api/render-public?pagePath=/leaderboard"
    },
    {
      "source": "/prompt-studio",
      "destination": "/api/render-public?pagePath=/prompt-studio"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://app.collectiveai.tools/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://app.collectiveai.tools/api/sitemap.xml"
    },
    {
      "source": "/ai-data.json",
      "destination": "https://app.collectiveai.tools/api/ai-data"
    },
    {
      "source": "/ai-manifest.json",
      "destination": "https://app.collectiveai.tools/api/ai-manifest"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
